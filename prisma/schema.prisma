generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String      @id @default(uuid())
  name           String
  email          String      @unique
  password       String
  avatar         String?
  onboarded      Boolean     @default(false)
  xp             Int         @default(100)
  level          Int         @default(1)
  streak         Int         @default(1)
  lastActiveDate String      @default("")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  settings          UserSettings?
  conversations     AiConversation[]
  studyMaterials    StudyMaterial[]
  studyNotes        StudyNote[]
  quizzes           Quiz[]
  codingProgress    CodingProgress[]
  careerApps        CareerApplication[]
  habits            Habit[]
  tasks             Task[]
  expenses          Expense[]
  studyDocs         StudyDocument[]
  studyProgress     StudyProgress[]
}

model UserSettings {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme          String   @default("cream")
  soundEnabled   Boolean  @default(true)
  reducedMotion  Boolean  @default(false)
  interests      String   @default("[]") // JSON string array
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  mode      String      @default("GENERAL") // GENERAL | STUDY | CODING | CAREER | WRITING
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // user | model
  content        String
  createdAt      DateTime       @default(now())
}

model StudyMaterial {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  fileName      String
  fileType      String   // pdf | image | text
  extractedText String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  flashcards    Flashcard[]
  quizzes       Quiz[]
}

model StudyNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  subject   String   @default("GENERAL")
  tags      String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Flashcard {
  id              String         @id @default(uuid())
  userId          String
  studyMaterialId String?
  studyMaterial   StudyMaterial? @relation(fields: [studyMaterialId], references: [id], onDelete: SetNull)
  question        String
  answer          String
  createdAt       DateTime       @default(now())
}

model Quiz {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyMaterialId String?
  studyMaterial   StudyMaterial? @relation(fields: [studyMaterialId], references: [id], onDelete: SetNull)
  title           String
  questionsJson   String         // JSON string of questions array
  score           Int            @default(0)
  completed       Boolean        @default(false)
  createdAt       DateTime       @default(now())
}

model CodingProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language    String   // PYTHON | JAVASCRIPT | HTML | CSS
  challengeId String
  level       Int      @default(1)
  completed   Boolean  @default(true)
  xp          Int      @default(50)
  code        String   @default("")
  completedAt DateTime @default(now())
}

model CareerApplication {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company             String
  role                String
  location            String    @default("Remote")
  status              String    @default("APPLIED") // WISHLIST | APPLIED | ASSESSMENT | INTERVIEW | OFFER | REJECTED
  salary              String?
  jobUrl              String?
  recruiter           String?
  notes               String?
  extractedSkillsJson String    @default("[]")
  dateApplied         DateTime  @default(now())
  interviewDate       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Habit {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    String   @default("GENERAL")
  streak      Int      @default(0)
  bestStreak  Int      @default(0)
  historyJson String   @default("[]") // JSON string of date strings
  createdAt   DateTime @default(now())
}

model Task {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  category  String   @default("GENERAL")
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Expense {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  category  String   @default("Other")
  date      String
  createdAt DateTime @default(now())
}

model StudyDocument {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  fileName         String
  fileSize         Int      @default(0)
  pageCount        Int      @default(1)
  extractedText    String   @default("")
  blobPathname     String?  // Private Vercel Blob pathname: users/{userId}/study/{documentId}/original/{safeFilename}
  blobUrl          String?  // Private Blob URL / identifier
  mimeType         String   @default("application/pdf")
  processingStatus String   @default("PENDING") // PENDING | UPLOADING | UPLOADED | EXTRACTING | CHUNKING | READY | FAILED
  processingProgress Int    @default(0)
  processingError  String?
  processedPages   Int      @default(0)
  summaryJson      String?  // Cached JSON summary for full document
  explanationText  String?  // Cached teacher-style explanation for full document
  keyPointsJson    String?  // Cached JSON key points for full document
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  chapters      StudyChapter[]
  chunks        StudyChunk[]
  progress      StudyProgress[]
  flashcards    StudyFlashcard[]
  quizQuestions StudyQuizQuestion[]

  @@index([userId])
}

model StudyChapter {
  id              String   @id @default(uuid())
  documentId      String
  document        StudyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chapterNumber   Int
  title           String
  content         String
  summaryJson     String?  // Cached JSON summary
  explanationText String?  // Cached teacher-style explanation
  keyPointsJson   String?  // Cached JSON key points
  createdAt       DateTime @default(now())

  chunks        StudyChunk[]
  flashcards    StudyFlashcard[]
  quizQuestions StudyQuizQuestion[]
  progress      StudyProgress[]

  @@index([documentId])
}

model StudyChunk {
  id          String        @id @default(uuid())
  documentId  String
  document    StudyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chapterId   String?
  chapter     StudyChapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chunkIndex  Int
  pageStart   Int
  pageEnd     Int
  content     String
  summaryText String?
  createdAt   DateTime      @default(now())

  @@index([documentId, chunkIndex])
  @@index([documentId, chapterId])
}

model StudyFlashcard {
  id          String        @id @default(uuid())
  userId      String
  documentId  String
  document    StudyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chapterId   String?
  chapter     StudyChapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  question    String
  answer      String
  cardType    String        @default("concept") // definition | concept | formula | comparison | fact
  mastered    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([userId, documentId])
}

model StudyQuizQuestion {
  id            String        @id @default(uuid())
  userId        String
  documentId    String
  document      StudyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chapterId     String?
  chapter       StudyChapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  question      String
  optionsJson   String        // JSON array of 4 choices
  correctAnswer Int           // Index 0, 1, 2, or 3
  explanation   String
  topic         String        @default("General")
  sourceSection String?
  userAnswer    Int?
  isCorrect     Boolean?
  createdAt     DateTime      @default(now())

  @@index([userId, documentId])
}

model StudyProgress {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId         String
  document           StudyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chapterId          String?
  chapter            StudyChapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  mode               String        // SUMMARIZE | EXPLAIN | FLASHCARDS | QUIZ | KEY_POINTS
  isCompleted        Boolean       @default(false)
  score              Int           @default(0)
  total              Int           @default(0)
  masteredCardsCount Int           @default(0)
  weakTopicsJson     String        @default("[]")
  updatedAt          DateTime      @updatedAt

  @@unique([userId, documentId, chapterId, mode], name: "user_doc_chapter_mode")
  @@index([userId, documentId])
}

